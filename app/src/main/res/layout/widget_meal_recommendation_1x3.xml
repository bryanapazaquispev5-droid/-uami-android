<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="@drawable/widget_background">

    <!-- Imagen real del plato -->
    <ImageView
        android:id="@+id/widget_dish_image"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:scaleType="centerCrop"
        android:background="@drawable/widget_icon_circle"
        android:layout_marginEnd="10dp"
        android:contentDescription="Imagen del plato" />

    <!-- Nombre e indicador rápido del momento del día -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Momento del día pequeño en morado -->
        <TextView
            android:id="@+id/widget_meal_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DESAYUNO"
            android:textColor="#FF7B2FBE"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/widget_dish_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hotcakes con miel"
            android:textColor="#FF1A1A2E"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="1dp" />
            
        <!-- Views fantasmas para compatibilidad de IDs -->
        <TextView
            android:id="@+id/widget_meal_emoji"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/widget_time_label"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/widget_dish_desc"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/widget_dish_rating"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/widget_extra_info"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Botón refrescar -->
    <TextView
        android:id="@+id/widget_refresh_btn"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:text="↻"
        android:textSize="13sp"
        android:gravity="center"
        android:textColor="#FFFFFFFF"
        android:background="@drawable/widget_btn_refresh"
        android:layout_marginStart="6dp" />

</LinearLayout>
