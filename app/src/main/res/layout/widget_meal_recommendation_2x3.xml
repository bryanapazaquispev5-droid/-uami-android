<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="0dp"
    android:background="@drawable/widget_background">

    <!-- Header con degradado, hora y nombre de app -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/widget_header_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_meal_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🍳"
            android:textSize="18sp"
            android:layout_marginEnd="6dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_meal_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Desayuno"
                android:textColor="#FFFFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:alpha="0.85" />

            <TextView
                android:id="@+id/widget_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Uami · Recomienda"
                android:textColor="#FFFFFFFF"
                android:textSize="8sp"
                android:alpha="0.6" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_time_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8:00 AM"
            android:textColor="#FFFFFFFF"
            android:textSize="9sp"
            android:alpha="0.7" />
    </LinearLayout>

    <!-- Cuerpo principal para 2x3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <!-- Imagen real del plato -->
        <ImageView
            android:id="@+id/widget_dish_image"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:background="@drawable/widget_icon_circle"
            android:layout_marginEnd="10dp"
            android:contentDescription="Imagen del plato" />

        <!-- Nombre, descripción y rating -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_dish_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hotcakes con miel"
                android:textColor="#FF1A1A2E"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_dish_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Suave, esponjoso y delicioso"
                android:textColor="#FF5A5A7A"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="1dp" />

            <TextView
                android:id="@+id/widget_dish_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐ 4.5"
                android:textColor="#FFFF9800"
                android:textSize="9sp"
                android:layout_marginTop="2dp" />
                
            <!-- View invisible para compatibilidad -->
            <TextView
                android:id="@+id/widget_extra_info"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Botón refrescar -->
        <TextView
            android:id="@+id/widget_refresh_btn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="↻"
            android:textSize="15sp"
            android:gravity="center"
            android:textColor="#FFFFFFFF"
            android:background="@drawable/widget_btn_refresh"
            android:layout_marginStart="6dp" />
    </LinearLayout>

</LinearLayout>
