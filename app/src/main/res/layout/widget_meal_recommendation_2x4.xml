<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="0dp"
    android:background="@drawable/widget_background">

    <!-- Header con degradado, hora y nombre de app -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/widget_header_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="5dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_meal_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🍳"
            android:textSize="16sp"
            android:layout_marginEnd="6dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_meal_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Desayuno"
                android:textColor="#FFFFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:alpha="0.85" />

            <TextView
                android:id="@+id/widget_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Uami · Recomienda"
                android:textColor="#FFFFFFFF"
                android:textSize="8sp"
                android:alpha="0.6" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_time_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8:00 AM"
            android:textColor="#FFFFFFFF"
            android:textSize="9sp"
            android:alpha="0.7" />
    </LinearLayout>

    <!-- Cuerpo principal para 2x4 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp">

        <!-- Fila superior: Plato, Info Principal y Botón de refresco -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Imagen real del plato más grande (de 64dp a 80dp) -->
            <ImageView
                android:id="@+id/widget_dish_image"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:scaleType="centerCrop"
                android:background="@drawable/widget_icon_circle"
                android:layout_marginEnd="12dp"
                android:contentDescription="Imagen del plato" />

            <!-- Nombre, descripción y rating -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_dish_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hotcakes con miel"
                    android:textColor="#FF1A1A2E"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_dish_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Suave, esponjoso y delicioso"
                    android:textColor="#FF5A5A7A"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="2dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/widget_dish_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐ 4.5"
                        android:textColor="#FFFF9800"
                        android:textSize="9sp"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/widget_extra_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fácil · 15 min"
                        android:textColor="#FF7A7A9A"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Botón refrescar -->
            <TextView
                android:id="@+id/widget_refresh_btn"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="↻"
                android:textSize="15sp"
                android:gravity="center"
                android:textColor="#FFFFFFFF"
                android:background="@drawable/widget_btn_refresh"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Divisor sutil -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FFE8E4F5"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp" />

        <!-- Fila inferior: Ingredientes principales -->
        <LinearLayout
            android:id="@+id/widget_ingredients_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_ingredients_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingredientes principales:"
                android:textColor="#FF7B2FBE"
                android:textSize="8sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <TextView
                android:id="@+id/widget_ingredients_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Harina, huevos, leche, miel"
                android:textColor="#FF5A5A7A"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Espaciador flexible para empujar el botón al fondo -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Botón Cocinar abajo centrado y ancho para ocupar espacio -->
        <TextView
            android:id="@+id/widget_cooking_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cocinar 👨‍🍳"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_btn_cooking" />

    </LinearLayout>

</LinearLayout>
